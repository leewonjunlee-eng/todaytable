DATABASE_PROVIDER=sqlite
SQLITE_PATH=./data/todaytable.sqlite
# Production: set DATABASE_PROVIDER=postgres and DATABASE_URL instead.
DATABASE_URL=postgres://todaytable:todaytable@localhost:5432/todaytable
SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_URL=http://localhost:3000
WORKER_ID=worker-local-1
# Optional: a second hostname on the SAME web service. No trailing paths.
# ADMIN_APP_URL=https://admin.your-domain.com
