{
  "name": "todaytable",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env.local --import tsx worker/index.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx --test tests/postgres.integration.test.ts",
    "test:sqlite": "node --env-file-if-exists=.env.local --import tsx tests/sqlite.integration.test.ts",
    "test:providers": "node tests/provider-harness.mjs",
    "test:render": "TODAYTABLE_IN_PROCESS_TYPESCRIPT=1 node --env-file-if-exists=.env.local scripts/render-smoke.mjs",
    "serve:unix": "node --env-file-if-exists=.env.local scripts/serve-unix.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/web-push": "3.6.4",
    "typescript": "5.9.3"
  }
}
